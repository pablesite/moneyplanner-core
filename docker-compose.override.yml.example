# docker-compose.override.yml.example
#
# Copy this file to docker-compose.override.yml to customise your local environment
# without touching docker-compose.yml (which is tracked in git).
#
# docker-compose automatically merges docker-compose.override.yml when present.
# The override file itself is listed in .gitignore so your local tweaks stay private.

services:
  backend:
    # Uncomment to expose debugpy for IDE step-through debugging (e.g. VS Code).
    # Also add `import debugpy; debugpy.listen(("0.0.0.0", 5678)); debugpy.wait_for_client()`
    # at the entry point you want to debug.
    # ports:
    #   - "5678:5678"

  db:
    # Change the host port if 5432 is already used on your machine.
    # ports:
    #   - "5433:5432"

  frontend:
    # Enable polling if hot-reload does not work from Windows-mounted filesystems.
    # environment:
    #   FRONTEND_USE_POLLING: "true"
    #   FRONTEND_POLLING_INTERVAL: "500"
