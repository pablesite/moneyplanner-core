# Core Frontend environment variables
# Copy this file to .env only when you need to override the defaults.
# Local Core development works without a frontend .env file.

# URL of the backend API used by this frontend. Default: http://localhost:8000
# VITE_API_BASE_URL=http://localhost:8000

# Optional override for hybrid deployments where Core API traffic must go to a
# different backend than auth/session traffic. Defaults to VITE_API_BASE_URL.
# VITE_CORE_API_BASE_URL=http://localhost:8000
