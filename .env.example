# Docker Compose host-level variables.
# Copy to .env and uncomment what you need.
# backend/.env controls all application-level settings (DB credentials, secrets, etc.).

# Windows/WSL2 (C:\ mount): enable polling so the frontend hot-reloads file changes.
# Not needed if you clone inside the WSL2 filesystem.
# FRONTEND_USE_POLLING=true
# FRONTEND_POLLING_INTERVAL=500
